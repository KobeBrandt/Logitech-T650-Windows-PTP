# ==========================================
# Logitech T650 Tray .gitignore
# ==========================================

# Visual Studio & IDE files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Build Outputs
[Bb]in/
[Oo]bj/
x64/
x86/
ARM64/
Debug/
Release/

# Test results & coverage
TestResults/
coverage/
*.coverage
coverage.cobertura.xml

# Certificates (never commit signing material)
*.cer
*.pfx

# Logs & Temporary files
*.log
*.tlog
*.tmp
*.bak
*.cache
*.intermediate
*.ilk
*.pdb
*.exp
*.lib

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Installer & Distribution artifacts
Dist/
publish/
publish-sc/
*.wixobj
*.wixpdb

